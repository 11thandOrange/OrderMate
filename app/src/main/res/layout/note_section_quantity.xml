<?xml version="1.0" encoding="utf-8"?>
<!-- Note Section for QUANTITY widgets (#139) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Section Label - set programmatically from DB widget label -->
    <TextView
        android:id="@+id/sectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/text_light"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Stepper -->
    <LinearLayout
        android:id="@+id/quantityInputLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_note_input"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/quantityDecrement"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:background="@drawable/bg_quantity_step_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Decrease quantity" />

        <TextView
            android:id="@+id/quantityValue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_light"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/quantityIncrement"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:background="@drawable/bg_quantity_step_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Increase quantity" />

    </LinearLayout>

</LinearLayout>
