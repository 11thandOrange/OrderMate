# Clover API Configuration
CLOVER_BASE_URL=https://api.clover.com

# For sandbox/testing use:
# CLOVER_BASE_URL=https://sandbox.dev.clover.com
# CLOVER_OAUTH_BASE_URL=https://apisandbox.dev.clover.com

# App-level OAuth credentials (NOT a per-merchant key). Find these in:
# Clover Developer Dashboard > Your App > App Settings > Configuration.
# Used only to exchange each merchant's one-time install code for that
# merchant's own access token (see src/oauth/cloverOAuthCallback.ts) -
# no merchant API token is ever hardcoded or shared across merchants.
CLOVER_CLIENT_ID=your-clover-app-client-id
CLOVER_CLIENT_SECRET=your-clover-app-client-secret

# OAuth token endpoint host. Defaults to https://www.clover.com if unset.
# CLOVER_OAUTH_BASE_URL=https://www.clover.com

# Required to verify inbound webhook requests are genuinely from Clover.
# Find this in: Clover Developer Dashboard > Your App > App Settings >
# Webhooks (only appears after completing the verification handshake).
# Without this set, every real webhook event is rejected with 401.
CLOVER_AUTH_CODE=your-clover-webhook-auth-code
