# Required to verify inbound webhook requests are genuinely from Clover.
# Find this in: Clover Developer Dashboard > Your App > App Settings >
# Webhooks (only appears after completing the verification handshake).
# Without this set, every real webhook event is rejected with 401.
CLOVER_AUTH_CODE=your-clover-webhook-auth-code

# OrderMate is a native Android-only Clover app (no "Web" REST client
# registered on the Developer Dashboard), so this Cloud Function has no way
# to obtain a per-merchant Clover REST API token to enrich merchantInfo
# (name/email/storeName) - those fields are stored blank. There is
# intentionally no CLOVER_API_TOKEN / CLOVER_CLIENT_ID / CLOVER_CLIENT_SECRET
# here; none of them can work for this app type without a separate,
# on-device (CloverAuth.authenticate) feature that does not exist yet.
